<?xml version="1.0"?>
<!--
  공식 pinky_description 로봇 + 시뮬레이션 전용 센서 추가.
  공식 파일은 고치지 않고 그대로 불러온다(pinky_description/urdf/robot.urdf.xacro 와 같은 호출).

  추가 센서
    ultrasonic (기본 켜짐) : 실물에도 있음. 실기 토픽 us_sensor/range(sensor_msgs/Range)는
                            us_range 노드가 이 센서의 us_scan 을 변환해 만든다.
    d455 (옵션)            : 실물 Pinky에는 없음. RealSense D455 를 올렸다고 가정한 튜토리얼 예제
                            (docs/pinky_sim_guide.html 센서 붙이기). 링크+조인트+센서를 직접 정의하는 방법을 보여 준다.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="pinky">
  <xacro:include filename="$(find pinky_description)/urdf/pinky.urdf.xacro"/>

  <xacro:arg name="namespace" default=""/>
  <xacro:arg name="cam_tilt_deg" default="8"/>
  <xacro:arg name="screen_tilt_deg" default="-25"/>
  <xacro:arg name="d455" default="false"/>
  <xacro:arg name="d455_x" default="0.03"/>          <!-- base_link 기준 앞쪽(m) -->
  <xacro:arg name="d455_z" default="0.16"/>          <!-- base_link 기준 높이(m). 라이다(약 0.1 m) 위 -->
  <xacro:arg name="d455_pitch_deg" default="15"/>    <!-- + 면 아래를 봄 -->

  <xacro:insert_robot namespace="$(arg namespace)" is_sim="true"
                      cam_tilt_deg="$(arg cam_tilt_deg)" screen_tilt_deg="$(arg screen_tilt_deg)"/>

  <!-- 초음파: 실기 pinky_sensor_adc 값(field_of_view 0.26 rad, 0.02~3.0 m)에 맞춘 좁은 라이다 -->
  <gazebo reference="$(arg namespace)ultrasonic_link">
    <sensor name="$(arg namespace)ultrasonic" type="gpu_lidar">
      <topic>$(arg namespace)us_scan</topic>
      <update_rate>20</update_rate>
      <gz_frame_id>$(arg namespace)ultrasonic_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal><samples>9</samples><min_angle>-0.13</min_angle><max_angle>0.13</max_angle></horizontal>
          <vertical><samples>5</samples><min_angle>-0.13</min_angle><max_angle>0.13</max_angle></vertical>
        </scan>
        <range><min>0.02</min><max>3.0</max><resolution>0.01</resolution></range>
      </lidar>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg d455)">
    <!-- 1) 장착: 기둥(mast) + 카메라 몸체. D455 외형 124 x 26 x 29 mm, 0.39 kg (Pinky에 꽤 무겁다) -->
    <link name="d455_mast">
      <visual><origin xyz="0 0 0.03"/><geometry><box size="0.01 0.01 0.06"/></geometry></visual>
      <collision><origin xyz="0 0 0.03"/><geometry><box size="0.01 0.01 0.06"/></geometry></collision>
      <inertial><origin xyz="0 0 0.03"/><mass value="0.02"/>
        <inertia ixx="1e-5" iyy="1e-5" izz="1e-6" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="d455_mast_joint" type="fixed">
      <parent link="base_link"/><child link="d455_mast"/>
      <origin xyz="$(arg d455_x) 0 ${$(arg d455_z) - 0.06}" rpy="0 0 0"/>
    </joint>
    <link name="d455_link">
      <visual><geometry><box size="0.026 0.124 0.029"/></geometry>
        <material name="d455_gray"><color rgba="0.25 0.25 0.28 1"/></material></visual>
      <collision><geometry><box size="0.026 0.124 0.029"/></geometry></collision>
      <inertial><mass value="0.39"/>
        <inertia ixx="5e-4" iyy="5e-5" izz="5e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="d455_joint" type="fixed">
      <parent link="d455_mast"/><child link="d455_link"/>
      <origin xyz="0 0 0.075" rpy="0 ${$(arg d455_pitch_deg) * pi / 180} 0"/>
    </joint>
    <gazebo reference="d455_mast_joint"><disableFixedJointLumping>true</disableFixedJointLumping></gazebo>
    <gazebo reference="d455_joint"><disableFixedJointLumping>true</disableFixedJointLumping></gazebo>

    <!-- 2) 센서: Gazebo rgbd_camera = RGB + 깊이 + 포인트클라우드를 한 번에.
         D455 깊이 FOV 87 x 58 deg, 권장 거리 0.6 ~ 6 m. 시뮬레이션 부하를 줄이려고 640x360 / 15 Hz -->
    <gazebo reference="d455_link">
      <sensor name="d455" type="rgbd_camera">
        <topic>d455</topic>
        <update_rate>15</update_rate>
        <gz_frame_id>d455_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image><width>640</width><height>360</height></image>
          <clip><near>0.6</near><far>6.0</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
