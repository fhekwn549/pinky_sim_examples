Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.02
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 60; 60
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 200
      Shape:
        Value: Arrow
        Shaft Length: 0.05
        Shaft Radius: 0.004
        Head Length: 0.02
        Head Radius: 0.01
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Layout objects
      Enabled: true
      Topic:
        Value: /layout_markers
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Range
      Name: Ultrasonic
      Enabled: true
      Topic:
        Value: /us_sensor/range
      Color: 255; 200; 0
      Alpha: 0.4
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: D455 points (virtual)
      Enabled: false
      Topic:
        Value: /d455/points
        Reliability Policy: Best Effort
      Size (m): 0.01
      Style: Points
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 250
      X: 0.2
      Y: 0.6
Window Geometry:
  Width: 1100
  Height: 800
