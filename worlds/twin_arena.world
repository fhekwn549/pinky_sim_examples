<?xml version="1.0"?>
<!-- 자동 생성 파일: make_world layouts/twin_arena.yaml 로 다시 만드세요. 직접 고치면 덮어써집니다. -->
<sdf version="1.8">
  <world name="twin_arena">
    <!-- pinky_gz_sim/worlds/empty.world 와 같은 시스템 플러그인. Sensors가 없으면 /scan이 안 나온다 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_back">
      <static>true</static>
      <pose>0.2000 1.3850 0.1250 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0400 0.0200 0.2500</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0400 0.0200 0.2500</size></box></geometry>
          <material><ambient>0.55 0.63 0.67 1</ambient><diffuse>0.55 0.63 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_left">
      <static>true</static>
      <pose>-0.8100 0.6250 0.1250 0 0 -1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5000 0.0200 0.2500</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5000 0.0200 0.2500</size></box></geometry>
          <material><ambient>0.55 0.63 0.67 1</ambient><diffuse>0.55 0.63 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_right">
      <static>true</static>
      <pose>1.2100 0.6250 0.1250 0 0 -1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5000 0.0200 0.2500</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5000 0.0200 0.2500</size></box></geometry>
          <material><ambient>0.55 0.63 0.67 1</ambient><diffuse>0.55 0.63 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_front">
      <static>true</static>
      <pose>0.2000 -0.1350 0.1250 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0400 0.0200 0.2500</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0400 0.0200 0.2500</size></box></geometry>
          <material><ambient>0.55 0.63 0.67 1</ambient><diffuse>0.55 0.63 0.67 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="partition_1">
      <static>true</static>
      <pose>-0.2000 1.0000 0.1250 0 0 -1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7500 0.0100 0.2500</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7500 0.0100 0.2500</size></box></geometry>
          <material><ambient>0.5 0.58 0.62 1</ambient><diffuse>0.5 0.58 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="partition_2">
      <static>true</static>
      <pose>0.4000 1.0000 0.1250 0 0 -1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7500 0.0100 0.2500</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7500 0.0100 0.2500</size></box></geometry>
          <material><ambient>0.5 0.58 0.62 1</ambient><diffuse>0.5 0.58 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_1">
      <static>true</static>
      <pose>-0.5000 1.2350 0.0550 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1800 0.2000 0.1100</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1800 0.2000 0.1100</size></box></geometry>
          <material><ambient>0.8 0.85 0.87 1</ambient><diffuse>0.8 0.85 0.87 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_2">
      <static>true</static>
      <pose>0.1000 1.2350 0.0550 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1800 0.2000 0.1100</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1800 0.2000 0.1100</size></box></geometry>
          <material><ambient>0.8 0.85 0.87 1</ambient><diffuse>0.8 0.85 0.87 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_3">
      <static>true</static>
      <pose>0.8000 1.2350 0.0550 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1800 0.2000 0.1100</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1800 0.2000 0.1100</size></box></geometry>
          <material><ambient>0.8 0.85 0.87 1</ambient><diffuse>0.8 0.85 0.87 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="demo_obstacle">
      <static>true</static>
      <pose>0.6000 0.0000 0.1000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.0800 0.2000 0.2000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.0800 0.2000 0.2000</size></box></geometry>
          <material><ambient>0.9 0.45 0.35 1</ambient><diffuse>0.9 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pushable_can">
      <static>false</static>
      <pose>-0.3500 0.2750 0.0800 0 0 0.0000</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.000236</ixx><iyy>0.000236</iyy><izz>0.000045</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.0300</radius><length>0.1600</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.0300</radius><length>0.1600</length></cylinder></geometry>
          <material><ambient>0.35 0.55 0.85 1</ambient><diffuse>0.35 0.55 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
